{
  "name": "zelar-backend",
  "version": "1.0.0",
  "scripts": {
    "import:dry": "tsx tools/importer/cli.ts",
    "test": "vitest run tools",
    "test:db": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=../frontend/.env tools/db/migrate.ts",
    "db:super-admin": "tsx --env-file=../frontend/.env tools/db/super-admin.ts",
    "import:load": "tsx --env-file=../frontend/.env tools/importer/load.ts"
  },
  "description": "Supabase (migrações), importador da planilha e contrato da API do Zelar",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.23.1"
  }
}
