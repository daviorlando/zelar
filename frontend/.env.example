# Copie para .env.local e preencha (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor; nunca no navegador nem no celular.
SUPABASE_SECRET_KEY=sb_secret_...
# Chave que o app de campo manda para baixar a lista de funcionários (gere com: openssl rand -base64url 32).
ZELO_DEVICE_KEY=
# Senha do cron diário que gera as ordens (Vercel manda em "Authorization: Bearer ..."). Gere como a de cima.
CRON_SECRET=
# Só para as ferramentas do backend (migrações e carga da planilha): Supabase → Connect → Direct → Session pooler.
SUPABASE_DB_URL=
