# Copie para .env e preencha (Supabase → Project Settings → API Keys). O painel e as ferramentas
# do backend leem o .env; o painel lê também o .env.local, que vale por cima (ex.: Supabase local).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor; nunca no navegador nem no celular.
SUPABASE_SECRET_KEY=sb_secret_...
# Chave que o app de campo manda para baixar a lista de funcionários (gere com: openssl rand -base64url 32).
ZELAR_DEVICE_KEY=
# Senha do cron diário que gera as ordens (Vercel manda em "Authorization: Bearer ..."). Gere como a de cima.
CRON_SECRET=
# Só para as ferramentas do backend (migrações e carga da planilha): Supabase → Connect → Direct → Session pooler.
SUPABASE_DB_URL=
# Endereço público do painel, usado nos links dos emails (ex.: https://zelar.suaempresa.com.br).
NEXT_PUBLIC_SITE_URL=
# Empresa dos APKs antigos, que ainda usam ZELAR_DEVICE_KEY. Eco Gesso: e0000000-0000-4000-8000-000000000001
ZELAR_LEGACY_COMPANY_ID=
# Só para `npm run auth:config` no backend (modelos de email do Supabase): supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Projeto do Supabase para `npm run auth:config` (Project Settings → General → Project ID). Sem ele, sai do endereço em NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF=
# Só em `npm run dev`: IPs de outros aparelhos da rede que podem abrir o painel, separados por vírgula (ex.: 192.168.0.10).
# ZELAR_DEV_ORIGINS=
